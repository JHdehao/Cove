<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 本地模型接口（Ollama / LM Studio）多为 http://：只放行局域网（IP、不带点的主机名、.local）和 Tailscale MagicDNS，云端一律 https -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- 只用系统 HTTPS，无自有加密：出口合规豁免 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Cove Pro 内购商品 ID，跟随签名时的 Bundle ID -->
	<key>CoveProProductID</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER).pro</string>
	<key>CoveCommit</key>
	<string>$(COVE_COMMIT)</string>
</dict>
</plist>
