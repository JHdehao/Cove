    "录音、实时字幕、纪要、对话、导出等其余功能全部免费，不受影响。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى التسجيل والترجمة المباشرة والمحاضر والمحادثة والتصدير وكل ما سواها مجانيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording, live captions, minutes, chat, export and everything else stay free."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音、ライブ字幕、議事録、チャット、書き出しなど、その他の機能はすべて無料のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음, 실시간 자막, 회의록, 대화, 내보내기 등 나머지 기능은 모두 무료입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись, живые субтитры, протоколы, чат, экспорт и всё остальное остаются бесплатными."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音、实时字幕、纪要、对话、导出等其余功能全部免费，不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音、即時字幕、紀要、對話、匯出等其餘功能全部免費，不受影響。"
          }
        }
      }
    },
