    "纪要": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحضر"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "議事録"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
