    "录音被打断约 %lld 秒，已自动继续。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقطع التسجيل نحو %lld ثانية واستُؤنف تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
