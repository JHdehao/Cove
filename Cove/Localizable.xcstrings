    },
    "录音超过 3 小时，手机上无法一次识别说话人。": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسجيل أطول من 3 ساعات، ولا يمكن التعرّف على المتحدثين على الهاتف دفعة واحدة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is over 3 hours, too long to identify speakers on the phone in one go."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音が 3 時間を超えているため、iPhone 上で一度に話者を識別できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 3시간을 넘어 휴대폰에서 한 번에 화자를 식별할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись длиннее 3 часов — слишком долго, чтобы определить говорящих на телефоне за раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音超过 3 小时，手机上无法一次识别说话人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音超過 3 小時，手機上無法一次識別說話人。"
          }
        }
      }
    },
