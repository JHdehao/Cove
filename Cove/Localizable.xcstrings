        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 약 %lld초 중단되었다가 자동으로 재개되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись прерывалась ≈%lld с и продолжилась автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
